{
  "name": "cute-games",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:release": "npm run build && npm run validate:release",
    "build:release:personal": "npm run build && npm run validate:release:personal",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "validate:release": "node scripts/validate-release.mjs --mode public",
    "validate:release:personal": "node scripts/validate-release.mjs --mode personal",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
